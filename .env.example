# =====================================================================
# Configuración Opcional de InvoiceToSheet
# =====================================================================

# Fallback LLM con OpenAI (Opcional: Si se deja en blanco, opera 100% con Reglas y Regex)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Configuración OCR (Pytesseract / Tesseract OCR)
# En Windows, si Tesseract no está en el PATH, especifica la ruta al ejecutable:
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
