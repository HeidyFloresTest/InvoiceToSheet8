# =====================================================================
# Configuración de Entorno para InvoiceToSheet
# =====================================================================

# Nivel de registro estructurado (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Motor OCR (Pytesseract / Tesseract OCR)
# En Windows o Linux, si el binario no está en el PATH del sistema, especifica la ruta:
# Ejemplo Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Ejemplo Linux: /usr/bin/tesseract
TESSERACT_PATH=

# Fallback LLM Opcional con OpenAI (Si se omite, opera 100% con Reglas y Regex)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rastreo de Errores y Monitoreo Externo con Sentry (Opcional en Producción)
SENTRY_DSN=

# Orígenes Permitidos para CORS (Separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Base de datos relacional para histórico y auditoría (Opcional, por defecto SQLite local)
DATABASE_URL=sqlite:///./invoices.db

